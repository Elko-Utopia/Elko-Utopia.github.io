---
/*
  Footer.astro — 文件说明（中文）

  包含页面底部（footer）结构与社交链接的小部件。简洁负责版权与外部链接显示，
  若需调整样式请改 `src/styles` 或局部 style 块，不要在此加入大量行为逻辑。
*/
const today = new Date();
const publicEndpoint = import.meta.env.PUBLIC_SUBSCRIBE_ENDPOINT;
const buttondownUser = import.meta.env.PUBLIC_BUTTONDOWN_USERNAME;

const endpoint = publicEndpoint || (buttondownUser ? `https://buttondown.email/api/emails/embed-subscribe/${buttondownUser}` : '');
